# Environments and secrets
myenv/
.venv/
.env

# Never commit data or results: both are reproduced from scripts and manifests.
# Anchored to the repository root. Unanchored, `data/` would also match the source
# package src/mflow/data/ and quietly keep the adapters out of every commit.
/data/
/results/

# Source documents
*.docx

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Editors and OS
.DS_Store
.idea/
*.swp

# The toy fixture is deliberately committed: it is the reference implementation of the
# data contract and the M1 acceptance tests depend on it.
!tests/fixtures/toy_site/
.mplcache/

# Scratch directories created by dataset-format probes.
.robod_probe/

# Report artefacts are derived: `mflow report` rebuilds them from results/, and results/
# is itself rebuilt from the run manifests. Committing a table would put a number in the
# repository whose provenance is a file that is not here.
/paper/
